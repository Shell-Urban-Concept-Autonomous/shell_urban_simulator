        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>package://shell_car_model/meshes/visual/zed_link.STL</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="zed_link_visual">
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>package://shell_car_model/meshes/visual/zed_link.STL</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <camera name="zed_camera">
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>2560</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.001</near>
            <far>300.7</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>20.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>camera_link_optical</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <gz_frame_id>zed_link</gz_frame_id>
        <topic>camera</topic>
      </sensor>

      <sensor name="rgbd_camera1" type="rgbd_camera">
        <camera name="zed_camera_point_cloud">
          <horizontal_fov>1.91986</horizontal_fov>
          <image>
            <width>2560</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>300.7</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>30.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <gz_frame_id>zed_link</gz_frame_id>
        <topic>camera_point</topic>
      </sensor>
    </link>

    <joint type="fixed" name="camera_optical_joint">
      <pose relative_to='zed_link'>0 0 0 -1.5707 0 -1.5707</pose>
      <parent>zed_link</parent>
      <child>camera_link_optical</child>
    </joint>
    <link name="camera_link_optical"/>

    <plugin
      filename="ignition-gazebo-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <steer_p_gain>10.0</steer_p_gain>
      <left_joint>motorized_joint</left_joint>
      <right_joint>rl_wheel_free_joint</right_joint>
      <left_steering_joint>fl_steering_joint</left_steering_joint>
      <right_steering_joint>fr_steering_joint</right_steering_joint>
      <kingpin_width>0.800</kingpin_width>
      <steering_limit>0.349066</steering_limit>
      <wheel_base>1.8</wheel_base>
      <wheel_separation>1.0</wheel_separation>
      <wheel_radius>0.6</wheel_radius>
      <min_velocity>-4.16667</min_velocity>
      <max_velocity>4.16667</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
      <topic>/cmd_vel</topic>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>fl_steering_joint</joint_name>
      <joint_name>fr_steering_joint</joint_name>
      <joint_name>motorized_joint</joint_name>
      <joint_name>fr_wheel_joint</joint_name>
      <joint_name>fl_wheel_joint</joint_name>
      <joint_name>rl_wheel_free_joint</joint_name>
      <update_rate>100</update_rate>
    </plugin>

    <plugin filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <odom_covariance_topic>odom</odom_covariance_topic>
      <tf_topic>tf</tf_topic>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>