    <link name="zed_link">
      <pose relative_to="zed_camera">0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.019269 1e-06 -0.000181 0 -0 0</pose>
        <mass>0.17032</mass>
        <inertia>
          <ixx>0.00038294</ixx>
          <ixy>3.2819e-09</ixy>
          <ixz>-6.4524e-08</ixz>
          <iyy>3.2574e-05</iyy>
          <iyz>1.3858e-09</iyz>
          <izz>0.00039062</izz>
        </inertia>
      </inertial>
