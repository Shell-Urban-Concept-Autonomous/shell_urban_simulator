    </joint>
    <link name="rl_wheel_link">
      <pose relative_to="rl_wheel_free_joint">0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.00044 0.002938 -1e-06 0 -0 0</pose>
        <mass>2.7917</mass>
        <inertia>
          <ixx>0.060714</ixx>
          <ixy>-4.9284e-07</ixy>
          <ixz>-5.8675e-06</ixz>
          <iyy>0.119</iyy>
          <iyz>-1.0058e-08</iyz>
