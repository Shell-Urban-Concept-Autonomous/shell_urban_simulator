      <sensor name="Lidar" type="gpu_lidar">
        <gz_frame_id>velodyne_link</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>10000</samples>
              <resolution>1</resolution>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <min_angle>-0.5353</min_angle>
              <max_angle>0.1862</max_angle>
          </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>200</max>
            <resolution>0.01</resolution>
          </range>
          <frame_id>/velodyne_link</frame_id>
        </lidar>
          <always_on>1</always_on>
          <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="zed_camera" type="fixed">
      <pose relative_to="base_link">0.846756 -0.008969 0.400393 0 -0 0</pose>
      <parent>base_link</parent>
      <child>zed_link</child>
      <axis>
        <xyz>0 0 1</xyz>
